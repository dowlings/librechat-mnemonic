# ── Required ──────────────────────────────────────────────────────────────────
LIBRECHAT_MONGO_URI=mongodb://mongo:27017/LibreChat

# Providers this proxy sits in front of. `baseUrl` is the provider root, such
# that <baseUrl>/v1/chat/completions (openai) or <baseUrl>/v1/messages
# (anthropic) is a valid URL.
UPSTREAMS=[{"name":"openai","baseUrl":"https://api.openai.com","api":"openai"}]

# ── mnemonic ──────────────────────────────────────────────────────────────────
MNEMONIC_VAULT_PATH=/vault
MNEMONIC_PROJECT_ROOT=/projects
MNEMONIC_WRITE_SCOPE=global
MNEMONIC_RECALL_SCOPE=all
MNEMONIC_RECALL_LIMIT=6

# Embeddings, read by the spawned mnemonic process.
EMBED_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
EMBED_MODEL=nomic-embed-text-v2-moe
# Set true when the vault is not a git repo.
DISABLE_GIT=false

# Use a hosted mnemonic instead of the bundled one. The project directories
# under MNEMONIC_PROJECT_ROOT must then exist on that host.
# MNEMONIC_MODE=remote
# MNEMONIC_URL=https://mnemonic.example.com/mcp
# MNEMONIC_HEADERS={"Authorization":"Bearer ..."}

# ── Behaviour ─────────────────────────────────────────────────────────────────
MEMORY_DEFAULT_ENABLED=true
MEMORY_WRITE_MODE=llm
MEMORY_MAX_CONTEXT_CHARS=4000
MEMORY_MAX_PER_TURN=3
MEMORY_PROJECTLESS=global

# ── Caching ───────────────────────────────────────────────────────────────────
# How long to cache note bodies (fetched via `get` after recall). 5 minutes
# keeps repeated turns fast without serving stale content for long.
CACHE_NOTE_BODY_TTL_MS=300000
# How long to cache recall results per (conversation, query). 2 minutes covers
# retries and edits without serving outdated search results.
CACHE_RECALL_TTL_MS=120000
# How long to cache memory on/off settings per (user, conversation). 30 seconds
# eliminates most MongoDB round-trips; toggles invalidate immediately.
CACHE_SETTINGS_TTL_MS=30000
# Shared entry cap for all three caches. Once a cache reaches this size, the
# oldest entry is evicted, bounding memory use in a long-running process.
CACHE_MAX_ENTRIES=5000

# ── Extraction model ──────────────────────────────────────────────────────────
# Omit to reuse the chat's own model and credentials.
# EXTRACT_BASE_URL=https://api.openai.com/v1
# EXTRACT_MODEL=gpt-4o-mini
# EXTRACT_API_KEY=sk-...

# ── Telemetry ─────────────────────────────────────────────────────────────────
# When set, the proxy creates its own Langfuse client and traces each chat
# turn with spans for resolve-context, recall, upstream, and memory-write.
# Share these with LibreChat's own Langfuse config so traces correlate.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Service ───────────────────────────────────────────────────────────────────
PORT=8710
LOG_LEVEL=info
MCP_ENABLED=true
MCP_PATH=/mcp